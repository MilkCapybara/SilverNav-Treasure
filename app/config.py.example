"""配置模块"""
import os


class Settings:
    """应用配置"""
    # PostgreSQL配置
    db_host = os.getenv("SILVERNAV_DB_HOST", "localhost")
    db_port = int(os.getenv("SILVERNAV_DB_PORT", "5432"))
    db_name = os.getenv("SILVERNAV_DB_NAME", "silvernav_db")
    db_schema = os.getenv("SILVERNAV_DB_SCHEMA", "silvernav")

    admin_user = os.getenv("SILVERNAV_DB_ADMIN_USER", "postgres")
    admin_password = os.getenv("SILVERNAV_DB_ADMIN_PASSWORD", "your_admin_password")

    read_user = os.getenv("SILVERNAV_DB_READ_USER", "read_user")
    read_password = os.getenv("SILVERNAV_DB_READ_PASSWORD", "your_read_password")

    # MongoDB配置
    mongo_host = os.getenv("SILVERNAV_MONGO_HOST", "localhost")
    mongo_port = int(os.getenv("SILVERNAV_MONGO_PORT", "27017"))
    mongo_db = os.getenv("SILVERNAV_MONGO_DB", "silvernav")
    mongo_user = os.getenv("SILVERNAV_MONGO_USER", "admin")
    mongo_password = os.getenv("SILVERNAV_MONGO_PASSWORD", "your_mongo_password")
    mongo_auth_source = os.getenv("SILVERNAV_MONGO_AUTH_SOURCE", "admin")

    # 认证配置
    root_account = os.getenv("SILVERNAV_ROOT_ACCOUNT", "root")
    root_password = os.getenv("SILVERNAV_ROOT_PASSWORD", "your_root_password")

    token_secret = os.getenv("SILVERNAV_TOKEN_SECRET", "your_secret_key_change_me")
    token_ttl_hours = int(os.getenv("SILVERNAV_TOKEN_TTL_HOURS", "12"))

    # Redis配置
    redis_host = os.getenv("SILVERNAV_REDIS_HOST", "localhost")
    redis_port = int(os.getenv("SILVERNAV_REDIS_PORT", "6379"))
    redis_db = int(os.getenv("SILVERNAV_REDIS_DB", "0"))
    redis_password = os.getenv("SILVERNAV_REDIS_PASSWORD", "your_redis_password")

    # Kafka配置
    kafka_bootstrap_servers = os.getenv("SILVERNAV_KAFKA_SERVERS", "localhost:9092")
    kafka_ais_topic = os.getenv("SILVERNAV_KAFKA_AIS_TOPIC", "ais.raw")
    kafka_alert_topic = os.getenv("SILVERNAV_KAFKA_ALERT_TOPIC", "alerts.realtime")


settings = Settings()
